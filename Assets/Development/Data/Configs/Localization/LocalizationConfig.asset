  _entries:
  - _key: play
    _text:
      _ru: "\u0418\u0433\u0440\u0430\u0442\u044C"
      _en: Play
  - _key: temple
    _text:
      _ru: "\u0425\u0440\u0430\u043C"
      _en: Temple
  - _key: select_level
    _text:
      _ru: "\u0412\u044B\u0431\u043E\u0440 \u0443\u0440\u043E\u0432\u043D\u044F"
      _en: Select Level
  - _key: back
    _text:
      _ru: "\u041D\u0430\u0437\u0430\u0434"
      _en: Back
  - _key: welcome_back
    _text:
      _ru: "\u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C!"
      _en: Welcome back!
  - _key: collect
    _text:
      _ru: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C"
      _en: Collect
  - _key: close
    _text:
      _ru: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
      _en: Close
  - _key: hand_power
    _text:
      _ru: "\u0421\u0438\u043B\u0430 \u0440\u0443\u043A\u0438"
      _en: Hand Power
  - _key: faith_capacity
    _text:
      _ru: "\u0401\u043C\u043A\u043E\u0441\u0442\u044C \u0432\u0435\u0440\u044B"
      _en: Faith Capacity
  - _key: miracle_power
    _text:
      _ru: "\u0421\u0438\u043B\u0430 \u0447\u0443\u0434\u0435\u0441"
      _en: Miracle Power
  - _key: buy
    _text:
      _ru: "\u041A\u0443\u043F\u0438\u0442\u044C"
      _en: Buy
  - _key: creature_coming_soon
    _text:
      _ru: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u2014 \u0441\u043A\u043E\u0440\u043E"
      _en: "Creature \u2014 Coming soon"
  - _key: next_level
    _text:
      _ru: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
      _en: Next level
  - _key: evil
    _text:
      _ru: "\u0417\u043B\u043E"
      _en: Evil
  - _key: good
    _text:
      _ru: "\u0414\u043E\u0431\u0440\u043E"
      _en: Good
  - _key: level_complete
    _text:
      _ru: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D"
      _en: Level Complete
  - _key: continue
    _text:
      _ru: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      _en: Continue
  - _key: faith_ran_out
    _text:
      _ru: "\u0412\u0435\u0440\u0430 \u0438\u0441\u0441\u044F\u043A\u043B\u0430"
      _en: Faith Ran Out
  - _key: watch_ad
    _text:
      _ru: "\u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u0443"
      _en: Watch ad
  - _key: later
    _text:
      _ru: "\u041F\u043E\u0437\u0436\u0435"
      _en: Later
  - _key: pause
    _text:
      _ru: "\u041F\u0430\u0443\u0437\u0430"
      _en: Pause
  - _key: resume
    _text:
      _ru: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      _en: Resume
  - _key: level_stalled_question
    _text:
      _ru: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u0443,
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
        \u0432\u0435\u0440\u0443?"
      _en: Watch an ad to refill your faith?
  - _key: upgrade_hand_power
    _text:
      _ru: "\u0421\u0438\u043B\u0430 \u0440\u0443\u043A\u0438"
      _en: Hand Power
  - _key: upgrade_faith_capacity
    _text:
      _ru: "\u0417\u0430\u043F\u0430\u0441 \u0432\u0435\u0440\u044B"
      _en: Faith Capacity
  - _key: upgrade_miracle_power
    _text:
      _ru: "\u0421\u0438\u043B\u0430 \u0447\u0443\u0434\u0435\u0441"
